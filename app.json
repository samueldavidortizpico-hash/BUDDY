{
  "expo": {
    "name": "BUDDY",
    "slug": "buddy",
    "version": "1.0.0",
    "description": "BUDDY, siempre contigo: acompañamiento, bienestar y recordatorios de medicamentos para adultos mayores y sus familias. Versión de demostración con datos de ejemplo.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buddy",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#174A59",
    "backgroundColor": "#F8FAF8",
    "ios": {
      "bundleIdentifier": "co.buddy.app",
      "supportsTablet": false
    },
    "android": {
      "package": "co.buddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "name": "BUDDY",
      "shortName": "BUDDY",
      "lang": "es",
      "themeColor": "#174A59",
      "backgroundColor": "#F8FAF8",
      "description": "BUDDY, siempre contigo. Versión de demostración con datos de ejemplo.",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
