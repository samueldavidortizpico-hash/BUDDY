{
  "expo": {
    "name": "BUDDY",
    "slug": "buddy",
    "version": "1.0.0",
    "description": "BUDDY, siempre contigo: acompañamiento, bienestar y recordatorios de medicamentos para adultos mayores y sus familias. Versión de demostración con datos de ejemplo.",
    "orientation": "portrait",
    "icon": "./assets/branding/buddy-icon-source.png",
    "scheme": "buddy",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#174A59",
    "backgroundColor": "#F8FAF8",
    "ios": {
      "bundleIdentifier": "co.buddy.app",
      "supportsTablet": false
    },
    "android": {
      "package": "co.buddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#CFF5EC",
        "foregroundImage": "./assets/branding/buddy-icon-foreground.png",
        "backgroundImage": "./assets/branding/buddy-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "name": "BUDDY",
      "shortName": "BUDDY",
      "lang": "es",
      "themeColor": "#174A59",
      "backgroundColor": "#F8FAF8",
      "description": "BUDDY, siempre contigo. Versión de demostración con datos de ejemplo.",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BUDDY usa la cámara solo cuando eliges fotografiar el envase de un medicamento.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BUDDY accede a las fotos que eliges para adjuntarlas a un medicamento.",
          "cameraPermission": "BUDDY usa la cámara solo cuando eliges fotografiar el envase de un medicamento.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#062639",
          "image": "./assets/branding/buddy-splash.png",
          "imageWidth": 188,
          "dark": {
            "backgroundColor": "#062639",
            "image": "./assets/branding/buddy-splash.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BUDDY usa tu ubicación solo si aceptas compartirla con tu familiar, mientras la app está abierta. Puedes dejar de compartirla cuando quieras.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#174A59"
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7880317c-e4b8-42ea-82d1-1c3a0a24e358"
      }
    }
  }
}
